<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.team2.project.model.dao.TransferStationDAO">

    <!-- Result Map for TransferStationDTO -->
    <resultMap id="transferStationResultMap" type="com.team2.project.model.dto.TransferStationDTO">
        <id property="transferId" column="transfer_id"/>
        <result property="stationId" column="station_id"/>
        <result property="transferTime" column="transfer_time"/>
        <result property="stationName" column="station_name"/>
        <collection property="lineNumbers" ofType="java.lang.Integer" column="station_id"
                    select="selectLineNumbersByStationId"/>
        <collection property="lineNames" ofType="java.lang.String" column="station_id"
                    select="selectLineNamesByStationId"/>
    </resultMap>

    <!-- 모든 환승역 조회 -->
    <select id="selectAllTransferStations" resultMap="transferStationResultMap">
        SELECT 
            ts.transfer_id,
            ts.station_id,
            ts.transfer_time,
            s.station_name
        FROM transfer_stations ts
        INNER JOIN stations s ON ts.station_id = s.station_id
        ORDER BY s.station_no
    </select>

    <!-- 환승역 ID로 환승역 조회 -->
    <select id="selectTransferStationById" parameterType="int" resultMap="transferStationResultMap">
        SELECT 
            ts.transfer_id,
            ts.station_id,
            ts.transfer_time,
            s.station_name
        FROM transfer_stations ts
        INNER JOIN stations s ON ts.station_id = s.station_id
        WHERE ts.transfer_id = #{transferId}
    </select>

    <!-- 역 ID로 환승 정보 조회 -->
    <select id="selectTransferStationByStationId" parameterType="int" resultMap="transferStationResultMap">
        SELECT 
            ts.transfer_id,
            ts.station_id,
            ts.transfer_time,
            s.station_name
        FROM transfer_stations ts
        INNER JOIN stations s ON ts.station_id = s.station_id
        WHERE ts.station_id = #{stationId}
    </select>

    <!-- 역이 환승역인지 확인 -->
    <select id="isTransferStation" parameterType="int" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM transfer_stations
        WHERE station_id = #{stationId}
    </select>

    <!-- 환승역의 노선 번호들 조회 (collection용) -->
    <select id="selectLineNumbersByStationId" parameterType="int" resultType="java.lang.Integer">
        SELECT l.line_no
        FROM `lines` l
        INNER JOIN station_lines sl ON l.line_id = sl.line_id
        WHERE sl.station_id = #{stationId}
        ORDER BY l.line_no
    </select>

    <!-- 환승역의 노선 이름들 조회 (collection용) -->
    <select id="selectLineNamesByStationId" parameterType="int" resultType="java.lang.String">
        SELECT l.line_name
        FROM `lines` l
        INNER JOIN station_lines sl ON l.line_id = sl.line_id
        WHERE sl.station_id = #{stationId}
        ORDER BY l.line_no
    </select>

    <!-- 환승역 추가 -->
    <insert id="insertTransferStation" parameterType="com.team2.project.model.dto.TransferStationDTO"
            useGeneratedKeys="true" keyProperty="transferId">
        INSERT INTO transfer_stations (station_id, transfer_time)
        VALUES (#{stationId}, #{transferTime})
    </insert>

    <!-- 환승역 정보 수정 -->
    <update id="updateTransferStation" parameterType="com.team2.project.model.dto.TransferStationDTO">
        UPDATE transfer_stations
        SET transfer_time = #{transferTime}
        WHERE transfer_id = #{transferId}
    </update>

    <!-- 환승역 삭제 -->
    <delete id="deleteTransferStation" parameterType="int">
        DELETE FROM transfer_stations
        WHERE transfer_id = #{transferId}
    </delete>

</mapper>
